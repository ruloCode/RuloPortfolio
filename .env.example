# This file is a placeholder for environment variables required to run this project.
# Currently, there are no environment variables needed.

# Example of what future variables might look like:
# NEXT_PUBLIC_API_KEY=your_api_key_here
# DATABASE_URL=your_database_url_here
# SECRET_KEY=your_secret_key_here

# Waitlist (AI Shift Challenge) — signups are stored in the `waitlist`
# table in Supabase. Until these are set, /api/waitlist responds 503 and
# the form shows the error state: do NOT drive traffic to the waitlist
# before configuring them. Get the secret key (sb_secret_...) at
# https://supabase.com/dashboard/project/_/settings/api-keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key

# Welcome email + audience sync via https://resend.com (both optional:
# without them the signup still works, it just skips the email).
# WAITLIST_FROM_EMAIL must be a sender on a domain verified in Resend —
# the default onboarding@resend.dev only delivers to the account owner,
# so real signups get nothing. Unsent rows (welcome_email_sent_at null)
# can be caught up with scripts/backfill-welcome-emails.ts.
RESEND_API_KEY=re_your_api_key
WAITLIST_FROM_EMAIL=Rulo <hola@rulocode.com>
RESEND_AUDIENCE_ID=your_audience_id

# Scheduling link for consulting CTAs (optional; falls back to Calendly).
# NEXT_PUBLIC_CAL_LINK=https://cal.com/<username>/30min

# Billing — Polar (merchant of record). Until POLAR_ACCESS_TOKEN and
# POLAR_PRODUCT_ID are set, /api/checkout answers 503 and the cohort card's
# button shows its error state: do NOT show the buy card to real users before
# configuring these. Set them in VERCEL too — the app builds fine without
# them and only fails at the moment someone tries to pay.
#
# Organization Access Token, from the Polar dashboard (sandbox and production
# are SEPARATE organizations with separate tokens and separate products).
POLAR_ACCESS_TOKEN=polar_oat_your_token
# The subscription product being sold. The PRICE LIVES HERE, not in the repo —
# nothing in the code ever hardcodes an amount.
POLAR_PRODUCT_ID=your_product_uuid
# Signs the webhook. Created with the webhook endpoint in the Polar dashboard,
# pointing at https://<your-domain>/api/webhooks/polar. Without it the webhook
# answers 503 and NOBODY gets access — this is the one that must never be
# missing in production.
POLAR_WEBHOOK_SECRET=polar_whs_your_secret
# 'production' or 'sandbox'. Fails closed: anything other than the literal
# 'production' is treated as sandbox, so a typo can never charge real money.
POLAR_SERVER=sandbox
# Absolute origin used for the checkout's successUrl and embedOrigin. Must be
# the real public origin — the embedded checkout iframe is refused if this
# does not match the page it opens on.
NEXT_PUBLIC_SITE_URL=https://rulocode.com
